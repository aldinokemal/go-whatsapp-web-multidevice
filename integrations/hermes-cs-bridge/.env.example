# hermes-cs-bridge configuration. On the server copy this file to
# /opt/gowa-deploy/cs-bridge.env (NOT into the git checkout) and fill it in.
# Guide: docs/cs-ai-hermes.md

# Address the bridge listens on. 172.17.0.1 is the docker0 gateway: reachable by
# the GOWA container, not from the internet. Check with: ip -4 addr show docker0
LISTEN_ADDR=172.17.0.1:8650

# Same secret as the CS device webhook in GOWA (min 16 chars).
# Generate: openssl rand -hex 32
WEBHOOK_SECRET=

# GOWA REST API (the bridge runs with host networking, so 127.0.0.1 works).
GOWA_URL=http://127.0.0.1:3000
# A dedicated account from APP_BASIC_AUTH in /opt/gowa/src/.env
GOWA_USER=cs-bridge
GOWA_PASS=
# Device id of the CS number in GOWA (the id used in X-Device-Id)
GOWA_DEVICE_ID=cs-ai

# Hermes API server of profile ruang-sanad (API_SERVER_PORT / API_SERVER_KEY in the
# profile's .env). With a multiplexed gateway use e.g. http://127.0.0.1:8642/p/ruang-sanad
HERMES_URL=http://127.0.0.1:8642
HERMES_API_KEY=
# Optional model alias; leave empty to use the profile default
HERMES_MODEL=
HERMES_TIMEOUT=180s
# Each WhatsApp number gets its own Hermes session: <prefix><number>
HERMES_SESSION_PREFIX=wa-cs-

# Settings page at https://<gowa-domain>/cs-ai (proxied by GOWA after Basic Auth).
# Must equal CS_AI_ADMIN_TOKEN in /opt/gowa/src/.env. Empty = page disabled.
# Generate: openssl rand -hex 32
ADMIN_TOKEN=

# Initial values only: on first start these seed /data/settings.json; after
# that, admin numbers, pause, debounce, rate limit, typing and the texts below
# are changed at /cs-ai, not here.
# Admin numbers that receive handoff notices and may send "AI ON/OFF <number>",
# comma-separated, e.g. 6281234567890,6289876543210
ADMIN_NUMBERS=

# How long the AI stays silent after a handoff or after an admin replies from the CS phone
PAUSE_DURATION=6h
# Quick consecutive messages are merged into one AI turn
DEBOUNCE=4s
DEBOUNCE_MAX_WAIT=15s
# Max messages per sender per hour handled by the AI (0 = unlimited)
RATE_LIMIT_PER_HOUR=30
MAX_MESSAGE_CHARS=3000
TYPING_INDICATOR=true

# The CS instructions (skill whatsapp-cs-closing + Ruang Sanad scripts) are built in
# from prompts/ruang-sanad-cs.md and edited at /cs-ai. This only seeds the
# instructions when settings.json does not exist yet:
# CS_SYSTEM_PROMPT_FILE=/data/cs-prompt.txt

# Optional custom texts
# FALLBACK_MESSAGE=Terima kasih, Kak. Pesan Kakak sudah kami terima. Admin akan membalas di chat ini secepatnya.
# HANDOFF_MESSAGE=Baik, Kak. Agar informasinya tepat, saya teruskan ke admin, ya. Admin akan membalas di chat ini.
# Empty (default): over the hourly limit the lead gets no notice, the admin is told.
# RATE_LIMIT_MESSAGE=

# CRM Leads in the Ruang Sanad Dashboard: every lead chat, form, payment info,
# transfer proof and handoff is sent to the Dashboard. Empty = off.
# Use the Dashboard's direct address (not the public domain / Nginx), port = its APP_PORT.
DASHBOARD_URL=
# Must equal CS_BRIDGE_INGEST_TOKEN in the Dashboard .env (min 32 chars).
# Generate: openssl rand -hex 32
DASHBOARD_INGEST_TOKEN=
# Events wait here while the Dashboard is unreachable
# DASHBOARD_OUTBOX_DIR=/data/outbox-dashboard

STATE_FILE=/data/state.json
SETTINGS_FILE=/data/settings.json
MEDIA_DIR=/data/media
